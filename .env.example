COMPOSE_PROJECT_NAME=carwash
TZ=Asia/Tehran
FRONTEND_PORT=80
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://backend:8000
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,example.com
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://example.com
DJANGO_DEV_FRONTEND_PORTS=5173
DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_MEDIA_ROOT=/app/media
DJANGO_USE_X_FORWARDED_HOST=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=False
DB_NAME=carwash
DB_USER=carwash
