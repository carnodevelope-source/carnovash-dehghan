FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-dev ffmpeg libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

COPY ai/final/requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --upgrade pip \
    && python3 -m pip install --index-url https://download.pytorch.org/whl/cu121 "torch>=2.2,<3" "torchvision>=0.17,<1" \
    && grep -vE '^(torch|torchvision)([=<>!]|$)' /tmp/requirements.txt > /tmp/requirements.docker.txt \
    && python3 -m pip install -r /tmp/requirements.docker.txt

COPY ai/final/ /app/

EXPOSE 8765

CMD ["python", "plate_http_service.py", "--host", "0.0.0.0", "--port", "8765"]
