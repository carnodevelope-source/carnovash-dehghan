COMPOSE_PROJECT_NAME=carwash
TZ=Asia/Tehran
FRONTEND_PORT=127.0.0.1:8080

PRIMARY_DOMAIN=carnowash.ir
SECONDARY_DOMAIN=www.carnowash.ir
LETSENCRYPT_EMAIL=admin@carnowash.ir

DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=carnowash.ir,www.carnowash.ir,192.168.1.120,127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://carnowash.ir,http://www.carnowash.ir,https://carnowash.ir,https://www.carnowash.ir,http://192.168.1.120,http://127.0.0.1,http://localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://carnowash.ir,http://www.carnowash.ir,https://carnowash.ir,https://www.carnowash.ir,http://192.168.1.120,http://127.0.0.1,http://localhost
DJANGO_USE_X_FORWARDED_HOST=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_BOOTSTRAP_PRODUCTION_DATA=True

DB_NAME=carwash
DB_USER=carwash
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
DB_CONN_MAX_AGE=60
MYSQL_SQL_MODE=STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
DB_SQL_MODE=STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

GUNICORN_WORKERS=3
GUNICORN_THREADS=24
LIVE_MAX_SUBSCRIBERS=12
REDIS_URL=redis://redis:6379/0
# After the dark P0 soak, enable Live V2 (outbox + replay). ASGI stays off;
# that is a separate canary and is not part of this step. Rollback is flag-off,
# not a business-data rollback.
LIVE_V2_ENABLED=true
LIVE_REPLAY_ENABLED=true
LIVE_OUTBOX_ENABLED=true
LIVE_ASGI_ENABLED=false
ASGI_WORKERS=3
VITE_LIVE_REPLAY_ENABLED=true
LIVE_REVISION_SAFETY_CHECK=true
LIVE_OUTBOX_RETENTION_HOURS=72
LIVE_REPLAY_BATCH_SIZE=100
LIVE_REPLAY_MAX_EVENTS=1000
LIVE_REPLAY_MAX_AGE_HOURS=72
LIVE_OUTBOX_CLEANUP_BATCH_SIZE=500
LIVE_OUTBOX_CLEANUP_MAX_BATCHES=20
LIVE_REDIS_CONNECT_TIMEOUT_SECONDS=2
LIVE_REDIS_SOCKET_TIMEOUT_SECONDS=2
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_RETENTION_HOURS=168
IDEMPOTENCY_CLEANUP_BATCH_SIZE=500
IDEMPOTENCY_CLEANUP_MAX_BATCHES=20
# Nightly SMS / stale-ticket / subscription-expiry jobs. Safe with multiple
# gunicorn workers: one runner per cycle is elected through Redis.
CARWASH_INTERNAL_SCHEDULER=1

PLATE_AI_SERVICE_URL=http://plate-ai:8765
PLATE_AI_TIMEOUT_SECONDS=5
PLATE_AI_PORT=8765
PLATE_AI_IMGSZ=640
PLATE_AI_THRESHOLD=0.30
PLATE_AI_MIN_BOX_AREA=300
PLATE_AI_BATCH_SIZE=8
PLATE_AI_BATCH_WAIT_MS=12
PLATE_AI_QUEUE_SIZE=256

IRANPAYAMAK_BASE_URL=https://api.iranpayamak.com
IRANPAYAMAK_LINE_NUMBER=PRO
IRANPAYAMAK_API_KEY=
SMS_PRICE_PER_SEGMENT=185
SMS_CHARS_PER_SEGMENT=70
# Optional: IranPayamak unsubscribe footer counted in billable length (default \nلغو11)
# SMS_PROVIDER_FOOTER=
