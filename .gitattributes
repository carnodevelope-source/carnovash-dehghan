* text=auto

# Keep source/data files with LF across platforms
*.py text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.vue text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.html text eol=lf

# Windows-native scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# AI model weights must use Git LFS for GitHub push compatibility
ai/tst/Persian-License-Plate-Recognition/weigths/**/*.pt filter=lfs diff=lfs merge=lfs -text
ai/tst/Persian-License-Plate-Recognition/weigths/**/*.pth filter=lfs diff=lfs merge=lfs -text
